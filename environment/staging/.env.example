APP_ENV=staging

SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost 127.0.0.1

DB_NAME=videocreate_staging_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Temporal
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=video-job-queue
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=temporal

# Google Cloud / YouTube Data API
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback
GOOGLE_OAUTH_MOCK=False

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Staging 初期管理者ユーザー (seed_staging コマンドで使用)
STAGING_ADMIN_EMAIL=admin@example.com
STAGING_ADMIN_PASSWORD=your-admin-password
